---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import{tools,href,pick,type Lang}from '../lib/content';
interface Props{lang:Lang}
const{lang}=Astro.props;
---
<Layout lang={lang} title={pick(lang,'Ferramentas de PDF simples e privadas','Simple, private PDF tools')} description={pick(lang,'Junte PDFs, converta imagens e separe páginas. Seus arquivos são processados no navegador.','Merge PDFs, convert images and split pages. Your files are processed in your browser.')}>
<section class="hero container"><div class="hero-copy"><div class="eyebrow"><span></span>{pick(lang,'MENOS COMPLICAÇÃO. MAIS POSSIBILIDADES.','LESS FRICTION. MORE POSSIBILITIES.')}</div><h1>{pick(lang,'Seus documentos,','Your documents,')}<br/><em>{pick(lang,'do seu jeito.','your way.')}</em></h1><p>{pick(lang,'Junte, separe e transforme seus arquivos com calma. Ferramentas simples, sem cadastro e direto no seu navegador.','Merge, split and transform your files with ease. Simple tools, no sign-up, right in your browser.')}</p><a href="#tools" class="primary hero-cta">{pick(lang,'Escolher uma ferramenta','Find your tool')}<Icon name="arrow" size={19}/></a><div class="hero-trust"><Icon name="shield" size={17}/>{pick(lang,'Seus arquivos ficam no seu dispositivo.','Your files stay on your device.')}</div></div>
<div class="hero-art" aria-hidden="true"><div class="art-orbit"></div><span class="art-star">✳</span><div class="art-paper back"><span>JPG</span><div class="mini-landscape"></div></div><div class="art-paper front"><span class="pdf-label">PDF</span><div class="paper-line long"></div><div class="paper-line"></div><div class="paper-line long"></div><div class="paper-block"></div><div class="paper-line"></div><div class="paper-line long"></div></div><div class="art-badge"><Icon name="check" size={18}/>{pick(lang,'Tudo no seu navegador','All in your browser')}</div><div class="art-arrow">↗</div></div></section>
<section id="tools" class="tools-section container"><div class="section-heading"><div><div class="eyebrow">{pick(lang,'COMECE POR AQUI','START HERE')}</div><h2>{pick(lang,'O que vamos resolver hoje?','What can we help with today?')}</h2></div><span class="count-tag">{pick(lang,'4 ferramentas de PDF','4 PDF tools')}</span></div>
<div class="tools-grid">{tools.map(tool=><a class:list={['tool-card',tool.color]} href={href(lang,tool)}><span class="tool-icon"><Icon name={tool.icon} size={29}/></span><div><h3>{tool.title[lang]}</h3><p>{tool.desc[lang]}</p></div><span class="card-arrow"><Icon name="arrow" size={21}/></span></a>)}</div></section>
<section id="how" class="how-section container"><div class="section-heading"><div><div class="eyebrow">{pick(lang,'DO ARQUIVO AO RESULTADO','FROM FILE TO FINISH')}</div><h2>{pick(lang,'Simples, de verdade.','Simple, really.')}</h2></div></div>
<div class="how-grid">{[
[pick(lang,'Escolha seus arquivos','Choose your files'),pick(lang,'Selecione ou arraste os documentos para a ferramenta.','Select or drop your documents into the tool.')],
[pick(lang,'Deixe do seu jeito','Make it yours'),pick(lang,'Organize a ordem, escolha as páginas e ajuste o resultado.','Arrange files, select pages and adjust the result.')],
[pick(lang,'Baixe e siga em frente','Download and carry on'),pick(lang,'O processamento acontece aqui, no seu navegador.','Processing happens here, in your browser.')]].map(([title,desc],i)=><article><span class="step-number">0{i+1}</span><h3>{title}</h3><p>{desc}</p></article>)}</div></section>
<div class="privacy-strip container"><Icon name="shield" size={25}/><p><strong>{pick(lang,'Privacidade desde o primeiro arquivo.','Privacy from the first file.')}</strong> {pick(lang,'Não enviamos seus documentos para um servidor. Ao fechar a página, eles não ficam guardados no site.','We do not upload your documents to a server. Closing the page clears them from the tool.')}</p></div>
</Layout>

