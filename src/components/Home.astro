---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import{tools,href,pick,reducePdfGuide,type Lang}from '../lib/content';
interface Props{lang:Lang}
const{lang}=Astro.props;
---
<Layout lang={lang} title={pick(lang,'Conversor de PDF e ferramentas online grátis','Free online PDF converter and tools')} description={pick(lang,'Converta PDF para Word ou imagem, crie PDFs com fotos e junte ou divida documentos. Ferramentas grátis, no navegador e sem enviar arquivos.','Convert PDF to Word or images, create PDFs from photos, and merge or split documents. Free browser tools with no file uploads.')}>
<section class="hero container"><div class="hero-copy"><div class="eyebrow"><span></span>{pick(lang,'MENOS COMPLICAÇÃO. MAIS POSSIBILIDADES.','LESS FRICTION. MORE POSSIBILITIES.')}</div><h1>{pick(lang,'Ferramentas de PDF','PDF tools')}<br/><em>{pick(lang,'no seu navegador.','in your browser.')}</em></h1><p>{pick(lang,'Converta PDF para Word ou imagem, transforme fotos em PDF e junte ou separe páginas. Grátis e sem cadastro.','Convert PDF to Word or images, turn photos into PDFs, and merge or split pages. Free, with no sign-up.')}</p><a href="#tools" class="primary hero-cta">{pick(lang,'Escolher uma ferramenta','Find your tool')}<Icon name="arrow" size={19}/></a><div class="hero-trust"><Icon name="shield" size={17}/>{pick(lang,'Seus arquivos ficam no seu dispositivo.','Your files stay on your device.')}</div></div>
<div class="hero-art" aria-hidden="true"><div class="art-orbit"></div><span class="art-star">✳</span><div class="art-paper back"><span>JPG</span><div class="mini-landscape"></div></div><div class="art-paper front"><span class="pdf-label">PDF</span><div class="paper-line long"></div><div class="paper-line"></div><div class="paper-line long"></div><div class="paper-block"></div><div class="paper-line"></div><div class="paper-line long"></div></div><div class="art-badge"><Icon name="check" size={18}/>{pick(lang,'Tudo no seu navegador','All in your browser')}</div><div class="art-arrow">↗</div></div></section>
<section id="tools" class="tools-section container"><div class="section-heading"><div><div class="eyebrow">{pick(lang,'COMECE POR AQUI','START HERE')}</div><h2>{pick(lang,'O que vamos resolver hoje?','What can we help with today?')}</h2></div><span class="count-tag">{tools.length} {pick(lang,'ferramentas de PDF','PDF tools')}</span></div>
<div class="tools-grid">{tools.map(tool=><a class:list={['tool-card',tool.color]} href={href(lang,tool)}><span class="tool-icon"><Icon name={tool.icon} size={29}/></span><div><h3>{tool.title[lang]}</h3><p>{tool.desc[lang]}</p></div><span class="card-arrow"><Icon name="arrow" size={21}/></span></a>)}</div></section>
<section id="how" class="how-section container"><div class="section-heading"><div><div class="eyebrow">{pick(lang,'DO ARQUIVO AO RESULTADO','FROM FILE TO FINISH')}</div><h2>{pick(lang,'Simples, de verdade.','Simple, really.')}</h2></div></div>
<div class="how-grid">{[
[pick(lang,'Escolha seus arquivos','Choose your files'),pick(lang,'Selecione ou arraste os documentos para a ferramenta.','Select or drop your documents into the tool.')],
[pick(lang,'Deixe do seu jeito','Make it yours'),pick(lang,'Organize a ordem, escolha as páginas e ajuste o resultado.','Arrange files, select pages and adjust the result.')],
[pick(lang,'Baixe e siga em frente','Download and carry on'),pick(lang,'O processamento acontece aqui, no seu navegador.','Processing happens here, in your browser.')]].map(([title,desc],i)=><article><span class="step-number">0{i+1}</span><h3>{title}</h3><p>{desc}</p></article>)}</div></section>
<div class="privacy-strip container"><Icon name="shield" size={25}/><p><strong>{pick(lang,'Privacidade desde o primeiro arquivo.','Privacy from the first file.')}</strong> {pick(lang,'Não enviamos seus documentos para um servidor. Ao fechar a página, eles não ficam guardados no site.','We do not upload your documents to a server. Closing the page clears them from the tool.')}</p></div>
<section class="more-tools container">
  <h2>{pick(lang,'Como escolher a melhor ferramenta de PDF para sua tarefa?','How do you choose the right PDF tool?')}</h2>
  <div>
    <a href={href(lang, tools[4])}>{pick(lang,'Quer editar o texto? Converta PDF para Word.', 'Need to edit text? Convert PDF to Word.')}<span aria-hidden="true">↗</span></a>
    <a href={href(lang, tools[2])}>{pick(lang,'Precisa enviar só algumas páginas? Extraia um trecho.', 'Need to send just a few pages? Extract them.')}<span aria-hidden="true">↗</span></a>
    <a href={href(lang, reducePdfGuide)}>{pick(lang,'Seu arquivo passou do limite? Veja como reduzir o tamanho de um PDF.', 'File too large? Learn how to reduce PDF file size.')}<span aria-hidden="true">↗</span></a>
  </div>
</section>
</Layout>

